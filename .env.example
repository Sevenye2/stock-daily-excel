# 复制成 .env 后填写（.env 已被 .gitignore 忽略，不会提交）

# 股票列表：6 位 A 股代码，逗号分隔，不要空格、不要引号
STOCK_LIST=300750,688256,688836

# 企业微信群机器人 Webhook（可选，不填就只写表不推送）
# 群右上角 … → 群机器人 → 添加机器人 → 复制 Webhook
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx

# 飞书群自定义机器人 Webhook（可选，不填就只写表不推送）
# 群设置 → 群机器人 → 添加机器人 → 自定义机器人 → 复制 Webhook 地址
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# 回溯天数（可选，默认 10）
# DAYS=10

# 北京时间几点之前不推送（可选，默认 08:00；本地手动跑一般不用管）
# QUIET_UNTIL=08:00
